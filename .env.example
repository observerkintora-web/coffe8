# Token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Public https URL where the webapp/ folder is hosted (see README)
WEBAPP_URL=https://your-domain.example/webapp/index.html

# Shown in bot messages
SHOP_NAME=Кофейня на Дерибасовской

# Comma-separated Telegram user IDs allowed to use /check and /redeem
ADMIN_IDS=111111111,222222222

# Hours before the same guest can play again
PLAY_COOLDOWN_HOURS=24

# Where the SQLite file is created
DB_PATH=roulette.db
